PORT=8090
DATA_DRIVER=mysql
DEMO_AUTH=true
AUTH_SECRET=replace-with-local-32-plus-char-secret
PRODUCTION_MODE=false
ALLOW_INSECURE_HTTP=true
ALLOW_JSON_PRODUCTION=false
ALLOW_ADMIN_RESTORE=false
DEBUG_ERRORS=false
TRUST_PROXY=false
LOG_LEVEL=info

MYSQL_DATABASE=syncerp
MYSQL_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
MYSQL_BIN=/Applications/MAMP/Library/bin/mysql80/bin/mysql
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-mamp-password
