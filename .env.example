PORT=8090
DATA_DRIVER=json
DEMO_AUTH=true
AUTH_SECRET=change-this-local-secret-before-live-use
PRODUCTION_MODE=false
ALLOW_INSECURE_HTTP=false
ALLOW_JSON_PRODUCTION=false
ALLOW_ADMIN_RESTORE=false
DEBUG_ERRORS=false

# Use DATA_DRIVER=mysql only after importing database/schema.mysql.sql into MAMP MySQL.
MYSQL_DATABASE=syncerp
MYSQL_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
MYSQL_BIN=/Applications/MAMP/Library/bin/mysql80/bin/mysql
MYSQL_USER=root
MYSQL_PASSWORD=
