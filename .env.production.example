NODE_ENV=production
PRODUCTION_MODE=true
PORT=8080

DEMO_AUTH=false
AUTH_SECRET=replace-with-32-plus-char-secret-from-secret-manager

DATA_DRIVER=mysql
MYSQL_DATABASE=syncerp
MYSQL_HOST=replace-with-private-db-host
MYSQL_PORT=3306
MYSQL_USER=syncerp_app
MYSQL_PASSWORD=replace-with-secret-manager-value
MYSQL_SOCKET=
MYSQL_BIN=mysql

ALLOW_INSECURE_HTTP=false
ALLOW_JSON_PRODUCTION=false
ALLOW_ADMIN_RESTORE=false
DEBUG_ERRORS=false
TRUST_PROXY=true
LOG_LEVEL=info
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
