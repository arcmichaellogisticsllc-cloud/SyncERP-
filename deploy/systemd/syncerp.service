[Unit]
Description=SyncERP Node service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/syncerp
EnvironmentFile=/etc/syncerp/syncerp.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
User=syncerp
Group=syncerp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
